CREATE TABLE `sprint3-analytics-daniel-lopez.sprint3_silver.transactions_clean` AS
SELECT id AS transaction_id,
    card_id,
    business_id,
    SAFE_CAST(timestamp AS TIMESTAMP) AS timestamp,
    IFNULL(SAFE_CAST(amount AS FLOAT64), 0) AS amount,
    declined,
    ARRAY(
        SELECT SAFE_CAST(TRIM(item) AS INT64)
        FROM UNNEST(SPLIT(CAST(product_ids AS STRING), ',')) AS item
        WHERE TRIM(item) != '') AS product_ids,
    user_id,
    SAFE_CAST(lat AS FLOAT64) AS lat,
    SAFE_CAST(longitude AS FLOAT64) AS longitude
FROM `sprint3-analytics-daniel-lopez.sprint3_bronze.transactions_raw`;
