--nivell 3 ex1
CREATE VIEW `sprint3-analytics-daniel-lopez.sprint3_gold.nivel3ex1` AS
SELECT
  company_name,
  phone,
  country,
  ROUND(AVG(amount), 2) AS avg_amount,
  CASE
    WHEN AVG(amount) > 260 THEN 'Premium'
    ELSE 'Standard'
  END AS client_tier
FROM `sprint3-analytics-daniel-lopez.sprint3_silver.companies_clean`
JOIN `sprint3-analytics-daniel-lopez.sprint3_silver.transactions_clean`
  ON company_id = CAST(business_id AS STRING)
GROUP BY
  company_name,
  phone,
  country;
-- ex2
CREATE OR REPLACE TABLE `sprint3_gold.product_sales_ranking` AS
SELECT
  productos.name AS product_name,
  productos.product_id,
  productos.price,
  productos.colour AS color,
  COALESCE(resumen_ventas.total_sold, 0) AS total_sold
FROM `sprint3_silver.products_clean` AS productos
LEFT JOIN (
  SELECT
    id_producto_vendido,
    COUNT(*) AS total_sold
  FROM `sprint3_silver.transactions_clean`,
  UNNEST(product_ids) AS id_producto_vendido
  GROUP BY id_producto_vendido
) AS resumen_ventas
  ON productos.product_id = resumen_ventas.id_producto_vendido
ORDER BY total_sold DESC;
